<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按键震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- 语音输入 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 只用来第一次下载离线翻译模型 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="com.kongye.permission.VAULT" />

    <queries>
        <provider android:authorities="com.kongye.docs.vault;com.kongye.docs.audit.vault;com.kongye.docs.docktest.vault;com.kongye.docs.upgradefixture.vault" />
        <package android:name="com.kongye.docs" />
        <package android:name="com.kongye.docs.audit" />
        <package android:name="com.kongye.docs.docktest" />
        <package android:name="com.kongye.docs.upgradefixture" />
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.APP_BROWSER" /></intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".KongyeApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Kongye">

        <service android:name=".WebDavBackupJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />

        <service android:name=".VoiceForegroundService" android:exported="false" android:foregroundServiceType="microphone" />
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".StatsReportActivity" android:exported="false" />
        <activity android:name=".ReceiptStyleActivity" android:exported="false" />
        <activity android:name=".TouchCalibrationActivity" android:exported="false" />

        <service
            android:name=".KongyeIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <receiver android:name=".SmsCodeReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter><action android:name="android.provider.Telephony.SMS_RECEIVED" /></intent-filter>
        </receiver>
        <receiver android:name=".SmsCodeExpiryReceiver" android:exported="false" />
        <receiver android:name=".UpdateInstallReceiver" android:exported="false" />

        <!-- 剪贴板里的图片上屏时用 content:// 地址交给对方应用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kongye.keyboard.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
